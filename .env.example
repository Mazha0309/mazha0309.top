# App
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
PORT=3000
TZ=Asia/Shanghai
DATABASE_URL=postgresql://mazha:change-me@postgres:5432/mazha_home
MEDIA_ROOT=/data/media
ALLOWED_GITHUB_ID=99137842

# Better Auth / GitHub OAuth
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Giscus (leave blank until the GitHub App and category are configured)
GISCUS_REPO=Mazha0309/mazha0309.top
GISCUS_REPO_ID=
GISCUS_CATEGORY=Blog Comments
GISCUS_CATEGORY_ID=

# Development only. Never enable this in production.
DEV_ADMIN_BYPASS=false

# Compose / deployment
POSTGRES_DB=mazha_home
POSTGRES_USER=mazha
POSTGRES_PASSWORD=change-me
CADDY_NETWORK=caddy
APP_IMAGE=mazha0309-top:local
