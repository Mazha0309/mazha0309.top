# App
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
PORT=3000
TZ=Asia/Shanghai
DATABASE_URL=postgresql://mazha:change-me@postgres:5432/mazha_home
MEDIA_ROOT=/data/media
ALLOWED_GITHUB_ID=99137842

# Better Auth / GitHub OAuth
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional fallback for AI comment moderation.
# You can instead enter the key directly in /admin/comments, where it is
# encrypted at rest. The on/off switch, endpoint, model, and policy also live there.
AI_MODERATION_API_KEY=
AI_MODERATION_TIMEOUT_MS=12000
# Optional defaults before the first save in /admin/comments:
# AI_MODERATION_BASE_URL=https://api.openai.com/v1
# AI_MODERATION_MODEL=gpt-5.6-luna

# Development only. Never enable this in production.
DEV_ADMIN_BYPASS=false

# Compose / deployment
POSTGRES_DB=mazha_home
POSTGRES_USER=mazha
POSTGRES_PASSWORD=change-me
APP_HOST_PORT=3000
APP_IMAGE=mazha0309blog:local
